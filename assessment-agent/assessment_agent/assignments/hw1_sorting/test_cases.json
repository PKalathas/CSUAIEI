{
  "assignment_id": "hw1_sorting",
  "title": "HW1: Sorting Algorithms",
  "description": "Implement a sorting function that reads integers from stdin and prints them sorted.",
  "test_cases": [
    {
      "name": "basic_sort",
      "input": "3 1 2",
      "expected_output": "1 2 3",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Sort three integers"
    },
    {
      "name": "already_sorted",
      "input": "1 2 3 4 5",
      "expected_output": "1 2 3 4 5",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Handle already sorted input"
    },
    {
      "name": "reverse_sorted",
      "input": "5 4 3 2 1",
      "expected_output": "1 2 3 4 5",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Sort reverse-ordered input"
    },
    {
      "name": "duplicates",
      "input": "3 1 2 1 3",
      "expected_output": "1 1 2 3 3",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Handle duplicate values"
    },
    {
      "name": "single_element",
      "input": "42",
      "expected_output": "42",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Single element input"
    },
    {
      "name": "negative_numbers",
      "input": "-3 1 -2 0 5",
      "expected_output": "-3 -2 0 1 5",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Sort with negative numbers"
    },
    {
      "name": "large_input",
      "input": "100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 83 82 81",
      "expected_output": "81 82 83 84 85 86 87 88 89 90 91 92 93 94 95 96 97 98 99 100",
      "points": 20,
      "timeout_seconds": 10,
      "description": "Handle larger input (20 elements)"
    }
  ]
}
