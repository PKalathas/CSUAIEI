{
  "assignment_id": "hw2_linked_list",
  "title": "HW2: Linked List Implementation",
  "description": "Implement a singly linked list with insert, delete, search, and display operations.",
  "test_cases": [
    {
      "name": "insert_and_display",
      "input": "insert 1\ninsert 2\ninsert 3\ndisplay",
      "expected_output": "1 -> 2 -> 3 -> None",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Insert three elements and display the list"
    },
    {
      "name": "search_existing",
      "input": "insert 10\ninsert 20\ninsert 30\nsearch 20",
      "expected_output": "Found",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Search for an element that exists"
    },
    {
      "name": "search_missing",
      "input": "insert 10\ninsert 20\nsearch 99",
      "expected_output": "Not Found",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Search for an element that does not exist"
    },
    {
      "name": "delete_middle",
      "input": "insert 1\ninsert 2\ninsert 3\ndelete 2\ndisplay",
      "expected_output": "1 -> 3 -> None",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Delete a middle element"
    },
    {
      "name": "delete_head",
      "input": "insert 1\ninsert 2\ninsert 3\ndelete 1\ndisplay",
      "expected_output": "2 -> 3 -> None",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Delete the head element"
    },
    {
      "name": "empty_list_display",
      "input": "display",
      "expected_output": "None",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Display an empty list"
    },
    {
      "name": "delete_from_empty",
      "input": "delete 5\ndisplay",
      "expected_output": "None",
      "points": 10,
      "timeout_seconds": 5,
      "description": "Delete from an empty list without crashing"
    },
    {
      "name": "insert_duplicates",
      "input": "insert 1\ninsert 1\ninsert 1\ndisplay",
      "expected_output": "1 -> 1 -> 1 -> None",
      "points": 15,
      "timeout_seconds": 5,
      "description": "Handle duplicate values correctly"
    }
  ]
}
