    <!-- Participant Agent → Cosmos DB: query by student_id -->
    <mxCell id="e_query" value="query by student_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7030a0;strokeWidth=1.5;fontSize=10;fontColor=#7030a0;dashed=1;dashStyle=8 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pa" target="cosmos">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Participant Agent → Azure OpenAI: generate_summary (context flow) -->
    <mxCell id="e_summary" value="_generate_summary(stats)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;fontColor=#1e4d2b;dashed=1;dashStyle=8 4;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cosmos" target="openai">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Participant Agent → Lab Companion: return context (dashed purple) -->
    <mxCell id="e_ctx_ret" value="return context  {total_questions, type_dist, avg_hint, summary}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7030a0;strokeWidth=1.5;fontSize=10;fontColor=#7030a0;dashed=1;dashStyle=8 4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="pa" target="lab">
